# Required
WEBHOOK_SECRET=change_me_to_the_same_secret_in_your_pine_script
BYBIT_API_KEY=your_demo_api_key
BYBIT_API_SECRET=your_demo_api_secret

# Demo settings
BYBIT_DEMO=true
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_CATEGORY=linear

# Symbol mapping from TradingView/Pine to Bybit symbols
# Example:
# SYMBOL_MAP_JSON={"BTCUSD":"BTCUSDT","ETHUSD":"ETHUSDT"}
SYMBOL_MAP_JSON={}

# Trade management defaults
PARTIAL_CLOSE_PCT=20
CANCEL_ALL_ON_CLOSE=true
CANCEL_ALL_ON_CANCEL_PENDING=true
ROUND_PRICES_TO_TICK=true

# Utilities
DRY_RUN=false
POSITION_IDX=0
BYBIT_RECV_WINDOW=5000
HTTP_TIMEOUT=15
LOG_LEVEL=INFO
BOT_DB_PATH=./data/bot_state.db
